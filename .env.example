# Supabase project settings -> API keys. Use the new keys, not anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server only. Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Any long random string. Vercel sends it as the Authorization header to the cron route.
CRON_SECRET=change-me

# Local development only (npx supabase start). Not needed in production.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
